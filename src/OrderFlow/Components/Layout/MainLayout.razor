@inherits LayoutComponentBase
@implements IDisposable
@inject PersonaContext PersonaCtx
@inject NavigationManager Nav

<CascadingValue Value="PersonaCtx.Current" Name="Persona">
<div class="container-scroller">
    <!-- Top navbar -->
    <nav class="navbar default-layout col-lg-12 col-12 p-0 fixed-top d-flex align-items-top flex-row">
        <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
            <a class="navbar-brand brand-logo" href="/">Order<span>Flow</span></a>
            <a class="navbar-brand brand-logo-mini" href="/">O<span>F</span></a>
        </div>
        <div class="navbar-menu-wrapper d-flex align-items-top">
            <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                <span class="mdi mdi-menu"></span>
            </button>
            <ul class="navbar-nav">
                <li class="nav-item font-weight-semibold d-none d-lg-block ms-0">
                    <h1 class="welcome-text mb-0">Design Patterns, <span class="text-white fw-bold">served hot</span></h1>
                    <p class="welcome-sub-text mb-0">Viewing as <span class="fw-bold">@PersonaCtx.DisplayName</span></p>
                </li>
            </ul>
            <ul class="navbar-nav navbar-nav-right">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" id="personaDropdown" href="#" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                        <span class="mdi mdi-account-circle me-1"></span>
                        <span class="d-none d-md-inline">@PersonaCtx.DisplayName</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end navbar-dropdown preview-list" aria-labelledby="personaDropdown">
                        <h6 class="p-3 mb-0">Switch persona</h6>
                        <div class="dropdown-divider"></div>
                        @foreach (var p in Enum.GetValues<Persona>())
                        {
                            <a class="dropdown-item preview-item @(p == PersonaCtx.Current ? "active" : "")"
                               href="#" @onclick="() => SetPersona(p)" @onclick:preventDefault>
                                <div class="preview-item-content">
                                    <p class="preview-subject mb-1">@Name(p)</p>
                                </div>
                            </a>
                        }
                    </div>
                </li>
            </ul>
            <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                <span class="mdi mdi-menu"></span>
            </button>
        </div>
    </nav>

    <div class="container-fluid page-body-wrapper">
        <NavMenu />

        <div class="main-panel">
            <div class="content-wrapper">
                @if (PersonaContext.CanAccess(PersonaCtx.Current, CurrentPath))
                {
                    @Body
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="mdi mdi-lock-outline me-1"></i>
                        This screen isn't part of the <strong>@PersonaCtx.DisplayName</strong> experience.
                        Switch persona (top-right) to view it.
                    </div>
                }
            </div>
            <footer class="footer">
                <div class="d-sm-flex justify-content-center justify-content-sm-between">
                    <span class="text-muted d-block text-center text-sm-start d-sm-inline-block">
                        OrderFlow &mdash; companion app for the C# Design Patterns book
                    </span>
                    <span class="float-none float-sm-end d-block mt-1 mt-sm-0 text-center">
                        UI shell: Corona (BootstrapDash), Bootstrap 5
                    </span>
                </div>
            </footer>
        </div>
    </div>
</div>
</CascadingValue>

@code {
    private string CurrentPath =>
        Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Split('/')[0];

    protected override void OnInitialized()
    {
        PersonaCtx.Changed += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void SetPersona(Persona p) => PersonaCtx.Current = p;

    private static string Name(Persona p) => p == Persona.KitchenStaff ? "Kitchen Staff" : p.ToString();

    public void Dispose()
    {
        PersonaCtx.Changed -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
